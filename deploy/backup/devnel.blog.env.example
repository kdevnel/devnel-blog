# Example config for scripts/backup/backup.sh and restore-test.sh.
# Install as ~/.config/devnel-backup/devnel.blog.env, mode 600, owned by the user that runs cron.
# The file is sourced by bash, so use VAR='value' syntax. It holds no passwords: MySQL credentials
# live in the two defaults files below. Never commit a real copy of this file.

# --- Required ---------------------------------------------------------------------------------
# WordPress root (wp-content/ lives here). Backups never include wp-config.php.
SITE_ROOT='/home/kyle/devnel.blog/public'
# Where backups are kept on this host (outside the web root).
BACKUP_DIR='/home/kyle/devnel.blog/backups-v2'
# mysqldump credentials as a [client] section (user, password, host), mode 600.
DB_DEFAULTS_FILE='/home/kyle/.config/devnel-backup/devnel.blog.my.cnf'

# --- Logging and alerts -----------------------------------------------------------------------
# Default when unset: <parent of SITE_ROOT>/logs/backup.log
LOG_FILE='/home/kyle/devnel.blog/logs/backup.log'
# Failure emails go through `wp eval wp_mail()`. Empty = the site's admin_email.
ALERT_EMAIL=''
# wp-cli binary (default: wp on PATH).
WP_BIN='/usr/local/bin/wp'

# --- Heartbeats (self-hosted Healthchecks; use one check per job) -----------------------------
# The script pings <url>/start, <url> on success and <url>/fail on failure.
HEARTBEAT_URL_DB=''
HEARTBEAT_URL_FILES=''
RESTORE_HEARTBEAT_URL=''

# --- Off-site ---------------------------------------------------------------------------------
# An rclone *crypt* remote and base folder, e.g. 'devnel-crypt:devnel.blog'. The script creates
# db/, files/ and nginx/ beneath it. Empty = no off-site copy (the script warns). Switching to
# another provider is a change to the rclone remote, not to this script.
OFFSITE_REMOTE=''

# --- Retention (days) -------------------------------------------------------------------------
# Local copies (files are deleted when older than this).
LOCAL_RETENTION_DB_DAYS=14
LOCAL_RETENTION_FILES_DAYS=56
# Off-site copies. The script prunes these itself (Google Drive has no lifecycle rules) and
# bypasses the Drive trash so deleted dumps stop using quota.
OFFSITE_RETENTION_DB_DAYS=90
OFFSITE_RETENTION_FILES_DAYS=182

# --- Disk guard -------------------------------------------------------------------------------
# Abort when free space on BACKUP_DIR is below this multiple of the expected backup size
# (DB: size of the newest dump; files: size of wp-content).
MIN_FREE_FACTOR=2
# Expected DB dump size in MB when there is no earlier dump to measure.
DB_FALLBACK_EXPECTED_MB=200

# --- Files backup -----------------------------------------------------------------------------
# nginx site config copied next to each files archive. Empty = skip.
NGINX_CONF='/etc/nginx/sites-available/devnel.blog'

# --- Restore test -----------------------------------------------------------------------------
# [client] defaults file for the restore-test MySQL user (rights on the scratch DB only), mode 600.
# Must be a different file, and a different MySQL user, from DB_DEFAULTS_FILE.
RESTORE_DEFAULTS_FILE='/home/kyle/.config/devnel-backup/devnel.blog.restore.my.cnf'
# Scratch database name. Default: <production db>_restoretest. Must end in _restoretest and must
# not equal the production database, or the script refuses to run.
#RESTORE_DB=''
# Allowed difference in published-post count between the dump and the live site (posts published
# since the dump was taken). Table count and siteurl must always match exactly.
RESTORE_POSTS_TOLERANCE=0
# The scratch database sits on the same disk as production MySQL, so the test aborts unless free
# space in the MySQL data directory is at least this multiple of the uncompressed dump size.
RESTORE_MIN_FREE_FACTOR=3
# MySQL data directory. Default: asked from the server (@@datadir).
#MYSQL_DATADIR=''

# --- Optional override ------------------------------------------------------------------------
# Production database name. Default: `wp config get DB_NAME` in SITE_ROOT.
#DB_NAME=''
