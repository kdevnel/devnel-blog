{
  "name": "devnel-blog",
  "version": "0.1.0",
  "private": true,
  "description": "devnel.blog WordPress block theme and operations tooling",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"theme/**/*.css\" --allow-empty-input",
    "lint:format": "prettier --check .",
    "lint:php": "vendor/bin/phpcs",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
    "test:shell": "bash scripts/check-shell.sh",
    "check": "npm run lint && npm run lint:php && npm run analyse && npm run test:shell"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@wordpress/env": "^11.17.0",
    "bats": "^1.13.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "shellcheck": "^4.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
