#!/usr/bin/env bash
# Stub mysqldump. STUB_MYSQLDUMP_FAIL=1 fails midway; STUB_MYSQLDUMP_BADHEADER=1 emits the old
# "password on the command line" warning as line 1; STUB_MYSQLDUMP_TRUNCATED=1 omits the trailer.
echo "mysqldump $*" >>"${STUB_LOG:?}"
if [[ "${STUB_MYSQLDUMP_BADHEADER:-}" == 1 ]]; then
  echo "mysqldump: [Warning] Using a password on the command line interface can be insecure."
fi
echo "-- MySQL dump 10.13  Distrib 8.x"
echo "CREATE TABLE wp_posts (ID int);"
if [[ "${STUB_MYSQLDUMP_FAIL:-}" == 1 ]]; then
  echo "mysqldump: Got error: 1045: Access denied" >&2
  exit 2
fi
echo "INSERT INTO wp_posts VALUES (1);"
if [[ "${STUB_MYSQLDUMP_TRUNCATED:-}" != 1 ]]; then echo "-- Dump completed on 2026-10-16 03:15:01"; fi
