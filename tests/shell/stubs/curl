#!/usr/bin/env bash
# Records the URL (last argument). STUB_CURL_FAIL=1 simulates an unreachable heartbeat host.
# STUB_CURL_FAIL_URL=<substring> fails (exit 22, as `curl -f` does on a 404) only for URLs containing it.
echo "curl ${*: -1}" >>"${STUB_LOG:?}"
if [[ "${STUB_CURL_FAIL:-}" == 1 ]]; then exit 7; fi
if [[ -n "${STUB_CURL_FAIL_URL:-}" && "${*: -1}" == *"$STUB_CURL_FAIL_URL"* ]]; then exit 22; fi
